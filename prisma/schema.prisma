generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model Profile {
  id String @id @default("main")
  name String @default("Una vida que nos une")
  subtitle String @default("Un lugar para guardar lo que nunca queremos olvidar.")
  introduction String @default("Aquí iremos reuniendo su historia: los días compartidos, las pequeñas costumbres y todo ese cariño que sigue encontrando nuevas formas de acompañarnos.")
  quote String @default("Lo que se comparte con amor se queda con nosotros.")
  heroPath String?
}
model Media {
  id String @id @default(cuid())
  title String
  caption String @default("")
  year String @default("")
  kind String
  path String @unique
  bytes Int
  position Int @default(0)
  published Boolean @default(false)
  createdAt DateTime @default(now())
}
model Memory {
  id String @id @default(cuid())
  name String
  message String
  approved Boolean @default(false)
  fingerprint String
  createdAt DateTime @default(now())
  @@index([approved, createdAt])
  @@index([fingerprint, createdAt])
}
